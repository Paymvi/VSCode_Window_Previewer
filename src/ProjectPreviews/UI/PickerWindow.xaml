<Window x:Class="ProjectPreviews.UI.PickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VS Code windows" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" ResizeMode="NoResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True" FontFamily="Segoe UI Variable Text, Segoe UI">
    <Canvas x:Name="Root">
        <!-- Nearly invisible (alpha 1) so the cursor can travel from the taskbar button to the cards without "leaving" us. -->
        <Rectangle x:Name="Bridge" Fill="#01000000" />
        <!-- Covers the VS Code taskbar button while we're open, so Explorer sees the pointer leave and doesn't open its own preview. -->
        <Border x:Name="Tab" CornerRadius="6" Background="{DynamicResource TabFill}" Cursor="Hand"
                AutomationProperties.Name="Visual Studio Code taskbar button" />
        <!-- Two static translucent layers instead of a DropShadowEffect (effects are slow in software rendering). -->
        <Border x:Name="ShadowFar" CornerRadius="22" Background="#14000000" />
        <Border x:Name="Shadow" CornerRadius="17" Background="#22000000" />
        <Border x:Name="Panel" CornerRadius="14" Background="{DynamicResource PopupBg}"
                BorderBrush="{DynamicResource PopupBorder}" BorderThickness="1" Padding="10,6,10,10">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="8,2,8,4" Height="22">
                    <TextBlock x:Name="Header" Foreground="{DynamicResource PopupSubtle}" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock x:Name="Hint" Foreground="{DynamicResource PopupSubtle}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
                <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <WrapPanel x:Name="CardsPanel" KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle"
                               AutomationProperties.Name="VS Code windows" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Canvas>
</Window>
