<Window x:Class="ProjectPreviews.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project Previews Settings" Width="820" Height="860" MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Background="{DynamicResource SurfaceBg}"
        Foreground="{DynamicResource PopupText}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14">
    <Window.Resources>
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceCard}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="H" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Foreground" Value="{DynamicResource PopupText}" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource PopupSubtle}" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="22,18,22,8">
            <Border x:Name="ProblemBox" Visibility="Collapsed" Background="#33F59E0B" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,14">
                <TextBlock x:Name="ProblemText" TextWrapping="Wrap" />
            </Border>

            <!-- General -->
            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H}" Text="General" />
                    <CheckBox x:Name="EnabledBox" Content="Enable project previews" Margin="0,0,0,8" />
                    <CheckBox x:Name="StartupBox" Content="Start with Windows" />
                    <TextBlock Style="{StaticResource Note}" Margin="28,2,0,0" Text="Runs in the tray at sign-in. Off unless you turn it on." />
                </StackPanel>
            </Border>

            <!-- Activation -->
            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H}" Text="How to open the picker" />
                    <CheckBox x:Name="HoverBox" Content="Hover the VS Code taskbar icon" />
                    <TextBlock x:Name="HoverNote" Style="{StaticResource Note}" Margin="28,2,0,10" />
                    <CheckBox x:Name="ShortcutBox" Content="Keyboard shortcut" />
                    <StackPanel Orientation="Horizontal" Margin="28,6,0,0">
                        <TextBox x:Name="ShortcutText" Width="220" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                 AutomationProperties.Name="Keyboard shortcut. Focus and press the new key combination." />
                        <TextBlock Style="{StaticResource Note}" VerticalAlignment="Center" Margin="12,0,0,0" Text="Click the box, then press the new combination." />
                    </StackPanel>
                    <TextBlock x:Name="ShortcutNote" Style="{StaticResource Note}" Margin="28,6,0,0" />
                    <TextBlock Style="{StaticResource Note}" Margin="0,10,0,0" Text="Left-clicking the tray icon also opens the picker." />
                </StackPanel>
            </Border>

            <!-- Appearance -->
            <Border Style="{StaticResource Section}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Style="{StaticResource H}" Text="Appearance" />
                        <TextBlock Text="Theme" Margin="0,0,0,4" />
                        <ComboBox x:Name="ThemeBox" Width="200" HorizontalAlignment="Left" AutomationProperties.Name="Theme">
                            <ComboBoxItem Content="System" />
                            <ComboBoxItem Content="Light" />
                            <ComboBoxItem Content="Dark" />
                        </ComboBox>
                        <TextBlock x:Name="BlurLabel" Margin="0,14,0,2" />
                        <Slider x:Name="BlurSlider" Minimum="0" Maximum="40" SmallChange="1" LargeChange="5" AutomationProperties.Name="Blur amount" />
                        <TextBlock x:Name="DarkLabel" Margin="0,10,0,2" />
                        <Slider x:Name="DarkSlider" Minimum="0" Maximum="90" SmallChange="1" LargeChange="10" AutomationProperties.Name="Darkness amount" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Note}" Text="Preview" Margin="6,0,0,4" />
                        <Border x:Name="SampleHost" Background="{DynamicResource PopupBg}" CornerRadius="12" Padding="4"
                                BorderBrush="{DynamicResource PopupBorder}" BorderThickness="1" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Projects -->
            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Refresh" Padding="14,4" />
                        <TextBlock Style="{StaticResource H}" Text="Projects and aliases" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock x:Name="AliasSourceNote" Style="{StaticResource Note}" Margin="0,0,0,10" />
                    <StackPanel x:Name="ProjectRows" />
                </StackPanel>
            </Border>

            <!-- Companion -->
            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H}" Text="VS Code companion extension" />
                    <TextBlock Style="{StaticResource Note}" Text="Optional, but recommended. It tells Project Previews each window's exact folder or workspace and active file name, so identically named folders and workspaces are told apart. It sends only paths and file names, never file contents, and only to a local folder." />
                    <TextBlock x:Name="CompanionStatus" Margin="0,10,0,8" TextWrapping="Wrap" />
                    <Button x:Name="InstallButton" Content="Install companion extension" HorizontalAlignment="Left" Padding="14,5" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="Footer" Style="{StaticResource Note}" Margin="2,0,0,12" />
        </StackPanel>
    </ScrollViewer>
</Window>
